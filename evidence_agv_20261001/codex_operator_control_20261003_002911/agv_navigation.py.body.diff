+    def box_swept_clear(self, pose, v, w, bounds):
+        """Measured enclosing rectangle versus occupied/unknown cell squares.
+
+        SAT checks the oriented box at subcell poses. Expanded blocked squares
+        conservatively cover translation and corner rotation between samples.
+        """
+        if not valid_body_bounds(bounds,self.body_radius) or len(pose)!=3 or not all(finite(x) for x in pose):return False
+        samples=twist_centres(v,w,spatial_step=min(.005,self.res/4))
+        if samples is None:return False
+        centres,padding=samples
+        padding+=self.body_radius*abs(w)*.5/(2*max(1,len(centres)-1))
+        ox,oy,yaw=self.origin;c,s=math.cos(yaw),math.sin(yaw)
+        pc,ps=math.cos(pose[2]),math.sin(pose[2])
+        deadline=time.monotonic()+min(self.budget_s,.025)
+        for i,(bx,by) in enumerate(centres):
+            wx,wy=pose[0]+pc*bx-ps*by,pose[1]+ps*bx+pc*by
+            px,py=c*(wx-ox)+s*(wy-oy),-s*(wx-ox)+c*(wy-oy)
+            angle=pose[2]-yaw+w*.5*i/max(1,len(centres)-1)
+            bc,bs=math.cos(angle),math.sin(angle)
+            polygon=[(px+bc*x-bs*y,py+bs*x+bc*y) for x,y in
+                     ((bounds[0],bounds[1]),(bounds[2],bounds[1]),(bounds[2],bounds[3]),(bounds[0],bounds[3]))]
+            lo_x,hi_x=min(p[0] for p in polygon)-padding,max(p[0] for p in polygon)+padding
+            lo_y,hi_y=min(p[1] for p in polygon)-padding,max(p[1] for p in polygon)+padding
+            if lo_x<=0 or lo_y<=0 or hi_x>=self.w*self.res or hi_y>=self.h*self.res:return False
+            axes=((1.,0.),(0.,1.),(bc,bs),(-bs,bc))
+            projections=[(min(x*ax+y*ay for x,y in polygon),max(x*ax+y*ay for x,y in polygon)) for ax,ay in axes]
+            for y in range(math.floor(lo_y/self.res),math.floor(hi_y/self.res)+1):
+                if time.monotonic()>deadline:return False
+                for x in range(math.floor(lo_x/self.res),math.floor(hi_x/self.res)+1):
+                    if self.data[y*self.w+x]==0:continue
+                    square=((x*self.res-padding,y*self.res-padding),((x+1)*self.res+padding,y*self.res-padding),
+                            ((x+1)*self.res+padding,(y+1)*self.res+padding),(x*self.res-padding,(y+1)*self.res+padding))
+                    separated=False
+                    for (ax,ay),(a,b) in zip(axes,projections):
+                        values=[sx*ax+sy*ay for sx,sy in square]
+                        if max(values)<a or min(values)>b:separated=True;break
+                    if not separated:return False
+        return True
+
+    def escape_swept_clear(self, pose, v, w, bounds=None):
+        """Leave an existing clearance-margin violation without entering collision.
+
+        The normal A* margin stays unchanged. This recovery is available only
+        when already inside that margin: the enclosing body must remain wholly
+        known-free, minimum clearance cannot decrease, and the endpoint must
+        improve it. Unknown cells and map boundaries remain obstacles.
+        """
+        if len(pose)!=3 or not all(finite(x) for x in pose) or v==0:return False
+        samples=twist_centres(v,w,spatial_step=min(.005,self.res/4))
+        if samples is None:return False
+        centres,padding=samples
+        if bounds is not None and not self.box_swept_clear(pose,v,w,bounds):return False
+        ox,oy,yaw=self.origin
+        c,s=math.cos(yaw),math.sin(yaw)
+        pc,ps=math.cos(pose[2]),math.sin(pose[2])
+        deadline=time.monotonic()+min(self.budget_s,.025)
+        clearances=[]
+        for bx,by in centres:
+            wx,wy=pose[0]+pc*bx-ps*by,pose[1]+ps*bx+pc*by
+            px,py=c*(wx-ox)+s*(wy-oy),-s*(wx-ox)+c*(wy-oy)
+            clearance=min(self.radius+.01,px,py,self.w*self.res-px,self.h*self.res-py)
+            if bounds is None and clearance<=self.body_radius+padding:return False
+            search=self.radius+.01
+            for y in range(max(0,math.floor((py-search)/self.res)),min(self.h-1,math.floor((py+search)/self.res))+1):
+                if time.monotonic()>deadline:return False
+                for x in range(max(0,math.floor((px-search)/self.res)),min(self.w-1,math.floor((px+search)/self.res))+1):
+                    if self.data[y*self.w+x]==0:continue
+                    dx=max(x*self.res-px,0.,px-(x+1)*self.res)
+                    dy=max(y*self.res-py,0.,py-(y+1)*self.res)
+                    clearance=min(clearance,math.hypot(dx,dy))
+            if bounds is None and clearance<=self.body_radius+padding:return False
+            if clearances and clearance<clearances[-1]-1e-7:return False
+            clearances.append(clearance)
+        return clearances[0]<self.radius and clearances[-1]>clearances[0]+.0001
 
