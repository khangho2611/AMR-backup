  "diagnostics_body": "<!DOCTYPE html>\r\n<html lang=\"vi\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>AGV MISSION CONTROL - SLAM & RADAR TACTICAL</title>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n  <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\r\n  <style>\r\n    :root {\r\n      --bg: #07090e;\r\n      --panel: #0d121d;\r\n      --card: #131b2a;\r\n      --border: #1e293b;\r\n      --cyan: #00f0ff;\r\n      --cyan-glow: rgba(0, 240, 255, 0.4);\r\n      --green: #10b981;\r\n      --green-glow: rgba(16, 185, 129, 0.4);\r\n      --yellow: #f59e0b;\r\n      --red: #ef4444;\r\n      --red-glow: rgba(239, 68, 68, 0.5);\r\n      --text: #f8fafc;\r\n      --text-muted: #94a3b8;\r\n    }\r\n    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; font-family: 'Plus Jakarta Sans', sans-serif; }\r\n    body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }\r\n    \r\n    header {\r\n      background: var(--panel); border-bottom: 1px solid var(--border);\r\n      padding: 10px 20px; display: flex; justify-content: space-between; align-items: center;\r\n    }\r\n    .brand { font-size: 16px; font-weight: 800; color: var(--cyan); display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono'; }\r\n    .status-badge { font-size: 11px; padding: 4px 10px; border-radius: 999px; font-weight: 800; font-family: 'JetBrains Mono'; }\r\n    .badge-safe { background: rgba(16, 185, 129, 0.2); color: var(--green); border: 1px solid var(--green); }\r\n    .badge-warn { background: rgba(245, 158, 11, 0.2); color: var(--yellow); border: 1px solid var(--yellow); }\r\n    .badge-danger { background: rgba(239, 68, 68, 0.2); color: var(--red); border: 1px solid var(--red); animation: pulse 0.8s infinite; }\r\n    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\r\n\r\n    main { display: grid; grid-template-columns: 1fr 380px; gap: 14px; padding: 14px; flex: 1; }\r\n    \r\n    /* KHUNG CANVAS VISUALIZER (RADAR & SLAM MAP) */\r\n    .viewport-box {\r\n      background: var(--panel); border: 1px solid var(--border); border-radius: 16px;\r\n      padding: 12px; display: flex; flex-direction: column; position: relative;\r\n    }\r\n    .view-tabs { display: flex; gap: 8px; margin-bottom: 10px; }\r\n    .tab-btn {\r\n      padding: 6px 14px; font-size: 12px; font-weight: 700; border-radius: 8px; cursor: pointer;\r\n      background: var(--card); color: var(--text-muted); border: 1px solid var(--border); transition: 0.2s;\r\n    }\r\n    .tab-btn.active { background: var(--cyan); color: #000; border-color: var(--cyan); box-shadow: 0 0 10px var(--cyan-glow); }\r\n    .canvas-container { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }\r\n    canvas { background: #04060a; border-radius: 12px; border: 1px solid #172033; max-width: 100%; height: auto; }\r\n\r\n    /* CỘT ĐIỀU KHIỂN BÊN PHẢI */\r\n    aside { display: flex; flex-direction: column; gap: 12px; }\r\n    .card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 14px; }\r\n    .card-title { font-size: 11px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 10px; display: flex; justify-content: space-between; font-family: 'JetBrains Mono'; }\r\n\r\n    /* TELEMETRY METRICS */\r\n    .tele-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\r\n    .tele-item { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 8px 4px; text-align: center; }\r\n    .tele-lbl { font-size: 9px; color: var(--text-muted); font-weight: 700; font-family: 'JetBrains Mono'; }\r\n    .tele-val { font-size: 16px; font-weight: 900; color: var(--cyan); font-family: 'JetBrains Mono'; }\r\n\r\n    /* NÚT TỰ HÀNH & NÚT DỪNG KHẨN CẤP CHUẨN ĐỒ HỌA CAO */\r\n    .action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }\r\n    .btn-action {\r\n      padding: 14px 6px; font-size: 12px; font-weight: 800; border-radius: 12px; cursor: pointer;\r\n      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; transition: 0.15s;\r\n    }\r\n    .btn-auto { background: #064e3b; border: 2px solid #059669; color: #34d399; }\r\n    .btn-auto:active, .btn-auto.active { background: #059669; color: #fff; box-shadow: 0 0 15px var(--green-glow); }\r\n    .btn-estop { background: #7f1d1d; border: 2px solid #dc2626; color: #fecaca; box-shadow: 0 0 15px var(--red-glow); }\r\n    .btn-estop:active { background: #b91c1c; transform: scale(0.96); }\r\n\r\n    /* CỤM PHÍM WASD D-PAD */\r\n    .dpad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-width: 280px; margin: 0 auto; }\r\n    .dpad-btn {\r\n      height: 56px; border-radius: 12px; border: 1px solid #334466; background: var(--card);\r\n      color: #fff; font-size: 18px; font-weight: 800; cursor: pointer; display: flex; flex-direction: column;\r\n      align-items: center; justify-content: center; gap: 2px; transition: 0.1s;\r\n    }\r\n    .dpad-btn:active, .dpad-btn.pressed { background: var(--cyan); color: #000; border-color: var(--cyan); transform: scale(0.95); }\r\n    .dpad-sub { font-size: 9px; font-family: 'JetBrains Mono'; opacity: 0.75; font-weight: 600; }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <header>\r\n    <div class=\"brand\">⚡ AGV ROBOT V2.0 // SLAM & RADAR</div>\r\n    <div style=\"display:flex; gap:8px; align-items:center;\">\r\n      <span style=\"font-size:11px; color:var(--text-muted); font-family:'JetBrains Mono';\">RPLIDAR C1: 10Hz</span>\r\n      <div class=\"status-badge badge-safe\" id=\"statusBadge\">TRẠNG THÁI: AN TOÀN</div>\r\n    </div>\r\n  </header>\r\n\r\n  <main>\r\n    <!-- KHUNG ĐỒ HỌA TRUNG TÂM -->\r\n    <div class=\"viewport-box\">\r\n      <div class=\"view-tabs\">\r\n        <button class=\"tab-btn active\" id=\"tabRadar\" onclick=\"switchView('radar')\">📡 RADAR QUÉT 360°</button>\r\n        <button class=\"tab-btn\" id=\"tabSlam\" onclick=\"switchView('slam')\">🗺 BẢN ĐỒ SLAM 2D</button>\r\n        <span style=\"margin-left:auto; font-size:11px; color:var(--cyan); font-family:'JetBrains Mono'; align-self:center;\" id=\"distIndicator\">VẬT CẢN: -- m</span>\r\n      </div>\r\n      <div class=\"canvas-container\">\r\n        <canvas id=\"viewCanvas\" width=\"600\" height=\"600\"></canvas>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- CỘT ĐIỀU KHIỂN & SỐ LIỆU -->\r\n    <aside>\r\n      <!-- TỌA ĐỘ VÀ VẬN TỐC THẬT -->\r\n      <div class=\"card\">\r\n        <div class=\"card-title\">\r\n          <span>Vị Trí & Động Lực Học</span>\r\n          <span style=\"color:var(--cyan);\" onclick=\"sendCmd('RESET')\">↺ RESET</span>\r\n        </div>\r\n        <div class=\"tele-grid\">\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">X (MÉT)</div><div class=\"tele-val\" id=\"valX\">0.000</div></div>\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">Y (MÉT)</div><div class=\"tele-val\" id=\"valY\">0.000</div></div>\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">GÓC</div><div class=\"tele-val\" id=\"valTh\">0.0°</div></div>\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">BÁNH T (RPM)</div><div class=\"tele-val\" id=\"valLRpm\">0.0</div></div>\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">BÁNH P (RPM)</div><div class=\"tele-val\" id=\"valRRpm\">0.0</div></div>\r\n          <div class=\"tele-item\"><div class=\"tele-lbl\">GẦN NHẤT</div><div class=\"tele-val\" id=\"valMinD\" style=\"color:var(--yellow);\">-- cm</div></div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- ĐIỀU KHIỂN CHỦ ĐỘNG & TỰ HÀNH -->\r\n      <div class=\"card\" style=\"flex:1;\">\r\n        <div class=\"card-title\">Bộ Điều Khiển Trung Tâm</div>\r\n        \r\n        <div class=\"action-grid\">\r\n          <button class=\"btn-action btn-auto\" id=\"btnAuto\" onclick=\"toggleAuto()\">\r\n            <span style=\"font-size:16px;\">🚀</span>\r\n            <span id=\"autoText\">BẬT TỰ ĐỘNG QUÉT MAP</span>\r\n          </button>\r\n          <button class=\"btn-action\" id=\"btnArm\" onclick=\"armControl()\">MỞ PHIÊN ĐIỀU KHIỂN</button>\r\n          <button class=\"btn-action btn-estop\" onclick=\"emergencyStop()\">\r\n            <span style=\"font-size:16px;\">🛑</span>\r\n            <span>DỪNG KHẨN CẤP</span>\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"dpad-grid\">\r\n          <button class=\"dpad-btn\" id=\"btnQ\"><span>↺</span><span class=\"dpad-sub\">Q (Xoay T)</span></button>\r\n          <button class=\"dpad-btn\" id=\"btnW\"><span>▲</span><span class=\"dpad-sub\">W (Tiến)</span></button>\r\n          <button class=\"dpad-btn\" id=\"btnE\"><span>↻</span><span class=\"dpad-sub\">E (Xoay P)</span></button>\r\n\r\n          <button class=\"dpad-btn\" id=\"btnA\"><span>◄</span><span class=\"dpad-sub\">A (Trái)</span></button>\r\n          <button class=\"dpad-btn\" style=\"background:#450a0a; border-color:#991b1b; color:#fca5a5;\" onclick=\"emergencyStop()\"><span>🛑</span><span class=\"dpad-sub\">Space</span></button>\r\n          <button class=\"dpad-btn\" id=\"btnD\"><span>►</span><span class=\"dpad-sub\">D (Phải)</span></button>\r\n\r\n          <div></div>\r\n          <button class=\"dpad-btn\" id=\"btnS\"><span>▼</span><span class=\"dpad-sub\">S (Lùi)</span></button>\r\n          <div></div>\r\n        </div>\r\n        \r\n        <!-- Ô NHẬP PID GỌN Ở GÓC DƯỚI PHẢI -->\r\n        <div style=\"margin-top:10px; background:#0c121e; border:1px solid #1e293b; border-radius:8px; padding:10px;\">\r\n          <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;\">\r\n            <span style=\"font-size:11px; font-weight:bold; color:var(--cyan); font-family:'JetBrains Mono';\">⚙️ THAM SỐ PID ĐỘNG CƠ</span>\r\n            <span id=\"pidStatusMini\" style=\"font-size:9px; color:var(--text-muted);\">SẴN SÀNG</span>\r\n          </div>\r\n          <div style=\"display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; margin-bottom:8px;\">\r\n            <div>\r\n              <label style=\"font-size:9px; font-weight:bold; color:var(--cyan); display:block; margin-bottom:2px;\">Kp (Tỉ lệ)</label>\r\n              <input type=\"number\" id=\"inputKpMini\" step=\"0.05\" value=\"0.50\" style=\"width:100%; background:#070a10; border:1px solid #334155; color:#fff; padding:4px; border-radius:4px; font-family:'JetBrains Mono'; font-weight:bold; font-size:11px; box-sizing:border-box;\">\r\n            </div>\r\n            <div>\r\n              <label style=\"font-size:9px; font-weight:bold; color:var(--green); display:block; margin-bottom:2px;\">Ki (Tích phân)</label>\r\n              <input type=\"number\" id=\"inputKiMini\" step=\"0.10\" value=\"1.50\" style=\"width:100%; background:#070a10; border:1px solid #334155; color:#fff; padding:4px; border-radius:4px; font-family:'JetBrains Mono'; font-weight:bold; font-size:11px; box-sizing:border-box;\">\r\n            </div>\r\n            <div>\r\n              <label style=\"font-size:9px; font-weight:bold; color:var(--yellow); display:block; margin-bottom:2px;\">Kd (Vi phân)</label>\r\n              <input type=\"number\" id=\"inputKdMini\" step=\"0.005\" value=\"0.010\" style=\"width:100%; background:#070a10; border:1px solid #334155; color:#fff; padding:4px; border-radius:4px; font-family:'JetBrains Mono'; font-weight:bold; font-size:11px; box-sizing:border-box;\">\r\n            </div>\r\n          </div>\r\n          <div style=\"display:flex; gap:6px; margin-bottom:8px;\">\r\n            <button onclick=\"applyPidMini()\" style=\"flex:2; background:#0284c7; color:#fff; border:none; padding:7px 4px; border-radius:6px; font-weight:bold; cursor:pointer; font-family:'JetBrains Mono'; font-size:10px; display:flex; align-items:center; justify-content:center; gap:4px;\">\r\n              <span>💾</span> <span>NẠP PID</span>\r\n            </button>\r\n            <button onclick=\"exportToExcel()\" style=\"flex:1; background:#16a34a; color:#fff; border:none; padding:7px 4px; border-radius:6px; font-weight:bold; cursor:pointer; font-family:'JetBrains Mono'; font-size:10px; display:flex; align-items:center; justify-content:center; gap:4px;\">\r\n              <span>📊</span> <span>XUẤT CSV</span>\r\n            </button>\r\n          </div>\r\n\r\n          <!-- LỊCH SỬ NẠP THÔNG SỐ RÚT GỌN TRỰC QUAN -->\r\n          <div style=\"border-top:1px solid #1e293b; padding-top:6px;\">\r\n            <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;\">\r\n              <span style=\"font-size:9px; font-weight:bold; color:var(--text-muted); font-family:'JetBrains Mono';\">LỊCH SỬ NẠP GẦN ĐÂY</span>\r\n              <span id=\"historyCount\" style=\"font-size:9px; color:var(--cyan); font-family:'JetBrains Mono';\">0 bản ghi</span>\r\n            </div>\r\n            <div style=\"max-height:90px; overflow-y:auto;\">\r\n              <table style=\"width:100%; border-collapse:collapse; font-size:9px; font-family:'JetBrains Mono'; text-align:left;\">\r\n                <thead>\r\n                  <tr style=\"color:var(--text-muted); border-bottom:1px solid #334155;\">\r\n                    <th style=\"padding:2px 4px;\">Giờ</th>\r\n                    <th style=\"padding:2px 4px;\">Kp</th>\r\n                    <th style=\"padding:2px 4px;\">Ki</th>\r\n                    <th style=\"padding:2px 4px;\">Kd</th>\r\n                    <th style=\"padding:2px 4px;\">Kết quả</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody id=\"historyTableBody\">\r\n                  <tr><td colspan=\"5\" style=\"text-align:center; padding:6px; color:#64748b;\">Chưa có bản ghi nào</td></tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div style=\"text-align:center; font-size:10px; color:var(--text-muted); margin-top:8px;\">\r\n          Giữ phím lái • Buông tay xe phanh • Nhấn Space dừng khẩn cấp\r\n        </div>\r\n      </div>\r\n    </aside>\r\n  </main>\r\n\r\n  <script>\r\n    const canvas = document.getElementById('viewCanvas');\r\n    const ctx = canvas.getContext('2d');\r\n    let currentView = 'radar';\r\n    let isAutoRunning = false;\r\n    let teleData = null;\r\n    let mapData = null;\r\n\r\n    function switchView(view) {\r\n      currentView = view;\r\n      document.getElementById('tabRadar').classList.toggle('active', view === 'radar');\r\n      document.getElementById('tabSlam').classList.toggle('active', view === 'slam');\r\n\r\n      if (view === 'slam') fetchMap();\r\n    }\r\n\r\n    // Persistent browser records also retain timeouts/disconnections.\r\n    let pidHistory;\r\n    try { pidHistory = JSON.parse(localStorage.getItem('agv_pid_history') || '[]'); }\r\n    catch (_) { pidHistory = []; }\r\n    if (!Array.isArray(pidHistory)) pidHistory = [];\r\n    pidHistory.forEach(row => { if (row.status === 'PENDING') { row.status = 'FAILED'; row.reason = 'Trang tải lại: chưa xác nhận kết quả MCU'; } });\r\n    let pidBusy = false;\r\n    const escapeHtml = value => String(value ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\r\n    function saveHistory() {\r\n      pidHistory = pidHistory.slice(-500);\r\n      try { localStorage.setItem('agv_pid_history', JSON.stringify(pidHistory)); } catch (_) {}\r\n      renderHistory();\r\n    }\r\n    function renderHistory() {\r\n      const tbody = document.getElementById('historyTableBody');\r\n      const countLbl = document.getElementById('historyCount');\r\n      if (!tbody) return;\r\n      if (countLbl) countLbl.innerText = pidHistory.length + ' bản ghi';\r\n      tbody.innerHTML = pidHistory.length ? pidHistory.slice(-10).reverse().map(row => {\r\n        const status = row.status || 'UNVERIFIED';\r\n        const color = status === 'APPLIED' ? 'var(--green)' : status === 'PENDING' ? 'var(--yellow)' : 'var(--red)';\r\n        return `<tr><td>${escapeHtml(row.time)}</td><td>${escapeHtml(row.kp)}</td><td>${escapeHtml(row.ki)}</td><td>${escapeHtml(row.kd)}</td><td style=\"color:${color}\" title=\"${escapeHtml(row.reason)}\">${escapeHtml(status)}</td></tr>`;\r\n      }).join('') : '<tr><td colspan=\"5\">Chưa có bản ghi nào</td></tr>';\r\n    }\r\n    async function applyPidMini() {\r\n      if (pidBusy) return;\r\n      const fields = ['inputKpMini','inputKiMini','inputKdMini'];\r\n      const strings = fields.map(id => document.getElementById(id).value.trim());\r\n      const values = strings.map(Number);\r\n      const lbl = document.getElementById('pidStatusMini');\r\n      if (strings.some(v => v === '') || values.some((v,i) => !Number.isFinite(v) || v < 0 || v > [20,50,5][i])) {\r\n        if (lbl) lbl.innerText = 'REJECTED: giá trị PID không hợp lệ';\r\n        return;\r\n      }\r\n      const [kp,ki,kd] = values;\r\n      const record = {time:new Date().toISOString(),kp,ki,kd,kf:.45,status:'PENDING',reason:'Chờ MCU xác nhận'};\r\n      pidHistory.push(record); saveHistory();\r\n      pidBusy = true;\r\n      if (lbl) lbl.innerText = 'PENDING: chờ MCU';\r\n      try {\r\n        const response = await fetch(`/api/pid?kp=${kp}&ki=${ki}&kd=${kd}&kf=0.45`, {signal:AbortSignal.timeout(2500)});\r\n        const result = await response.json();\r\n        const accepted = response.ok && result.status === 'APPLIED';\r\n        record.status = accepted ? 'APPLIED' : result.status === 'REJECTED' ? 'REJECTED' : 'FAILED';\r\n        record.reason = result.reason || 'Không có xác nhận MCU hợp lệ';\r\n      } catch (_) {\r\n        record.status = 'FAILED';\r\n        record.reason = 'Mất kết nối hoặc timeout; chưa xác nhận MCU';\r\n      } finally {\r\n        pidBusy = false;\r\n        saveHistory();\r\n        if (lbl) { lbl.innerText = record.status + ': ' + record.reason; lbl.style.color = record.status === 'APPLIED' ? 'var(--green)' : 'var(--red)'; }\r\n      }\r\n    }\r\n\r\n    function applyPid() {\r\n      applyPidMini();\r\n    }\r\n\r\n    function exportToExcel() {\r\n      const columns = ['time','kp','ki','kd','kf','status','reason'];\r\n      const quote = v => '\"' + String(v ?? '').replace(/\"/g, '\"\"') + '\"';\r\n      const csv = [columns, ...pidHistory.map(row => columns.map(k => row[k]))].map(row => row.map(quote).join(',')).join('\\r\\n');\r\n      const url = URL.createObjectURL(new Blob(['\\ufeff' + csv], {type:'text/csv;charset=utf-8'}));\r\n      const link = document.createElement('a'); link.href = url; link.download = 'agv_pid_history.csv'; link.click();\r\n      setTimeout(() => URL.revokeObjectURL(url), 1000);\r\n    }\r\n\r\n    function clearHistory() {\r\n      if (confirm('Bạn có chắc muốn xóa sạch toàn bộ lịch sử đo đạc PID không?')) {\r\n        pidHistory = [];\r\n        localStorage.removeItem('agv_pid_history');\r\n        renderHistory();\r\n      }\r\n    }\r\n\r\n    // Tự động render lịch sử ban đầu\r\n    setTimeout(renderHistory, 500);\r\n\r\n    async function sendCmd(cmd) {\r\n      try {\r\n        const response = await fetch('/api/cmd?val=' + encodeURIComponent(cmd), {signal:AbortSignal.timeout(1200)});\r\n        const data = await response.json();\r\n        if (!response.ok) {\n          document.getElementById('statusBadge').innerText = data.reason || 'Lệnh bị từ chối';\n          if (sessionTimer) clearInterval(sessionTimer);\n          sessionTimer = null;\n          if (driveTimer) clearInterval(driveTimer);\r\n          driveTimer = null; driveCmd = null;\r\n        }\r\n        return response.ok;\r\n      } catch (_) {\n        if (sessionTimer) clearInterval(sessionTimer);\n        sessionTimer = null;\n        if (driveTimer) clearInterval(driveTimer);\r\n        driveTimer = null; driveCmd = null;\r\n        document.getElementById('statusBadge').innerText = 'MẤT KẾT NỐI — DỪNG CHƯA XÁC NHẬN';\r\n        return false;\r\n      }\r\n    }\r\n    let sessionTimer = null;\r\n    async function armControl() {\r\n      if (await sendCmd('ARM')) {\r\n        if (sessionTimer) clearInterval(sessionTimer);\r\n        sessionTimer = setInterval(() => { if (!driveCmd && !isAutoRunning) sendCmd('V 0.000 0.000'); },150);\r\n      }\r\n    }\r\n\r\n    function toggleAuto() {\r\n      const act = isAutoRunning ? 'STOP' : 'START';\r\n      fetch('/api/auto?act=' + act).then(r=>r.json()).then(d=>{\r\n        isAutoRunning = d.auto;\r\n        const btn = document.getElementById('btnAuto');\r\n        const txt = document.getElementById('autoText');\r\n        if (isAutoRunning) {\r\n          btn.classList.add('active');\r\n          txt.innerText = 'DỪNG QUÉT MAP';\r\n          btn.style.background = '#d97706';\r\n          btn.style.borderColor = '#f59e0b';\r\n        } else {\r\n          btn.classList.remove('active');\r\n          txt.innerText = 'BẬT TỰ ĐỘNG QUÉT MAP';\r\n          btn.style.background = '#064e3b';\r\n          btn.style.borderColor = '#059669';\r\n        }\r\n      });\r\n    }\r\n\r\n    function emergencyStop() {\n      // STOP endpoint also disables AUTO. One operation, one confirmation.\n      stopDrive(true);\n      isAutoRunning = false;\r\n      const btn = document.getElementById('btnAuto');\r\n      document.getElementById('autoText').innerText = 'BẬT TỰ ĐỘNG QUÉT MAP';\r\n      btn.style.background = '#064e3b';\r\n      btn.style.borderColor = '#059669';\r\n    }\r\n\r\n    function fetchMap() {\r\n      fetch('/api/map_full').then(r=>r.json()).then(d=>{\r\n        mapData = d;\r\n      }).catch(()=>{});\r\n    }\r\n\r\n    // VẼ RADAR HOẶC BẢN ĐỒ SLAM\r\n    function render() {\r\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n      const cx = canvas.width / 2;\r\n      const cy = canvas.height / 2;\r\n\r\n      if (currentView === 'radar') {\r\n        // 1. Vẽ vòng tròn Radar\r\n        ctx.strokeStyle = '#1e293b';\r\n        ctx.lineWidth = 1;\r\n        for (let r = 50; r <= 250; r += 50) {\r\n          ctx.beginPath();\r\n          ctx.arc(cx, cy, r, 0, Math.PI * 2);\r\n          ctx.stroke();\r\n        }\r\n\r\n        // Vẽ các tia trục\r\n        ctx.beginPath();\r\n        ctx.moveTo(cx - 250, cy); ctx.lineTo(cx + 250, cy);\r\n        ctx.moveTo(cx, cy - 250); ctx.lineTo(cx, cy + 250);\r\n        ctx.stroke();\r\n\r\n        // 2. Vẽ đám mây điểm LaserScan\r\n        if (teleData && teleData.ranges) {\r\n          const scale = 75; // 75px = 1m (phạm vi ~3.5m)\r\n          ctx.fillStyle = '#00f0ff';\r\n          teleData.ranges.forEach((dist, deg) => {\r\n            if (dist > 0.05 && dist < 4.0) {\r\n              const rad = (deg - 90) * Math.PI / 180.0;\r\n              const px = cx + dist * Math.cos(rad) * scale;\r\n              const py = cy + dist * Math.sin(rad) * scale;\r\n              \r\n              if (dist < 0.35) ctx.fillStyle = '#ef4444';\r\n              else if (dist < 0.70) ctx.fillStyle = '#f59e0b';\r\n              else ctx.fillStyle = '#00f0ff';\r\n              \r\n              ctx.fillRect(px - 2, py - 2, 4, 4);\r\n            }\r\n          });\r\n        }\r\n\r\n        // 3. Vẽ vị trí xe Robot ở tâm\r\n        ctx.fillStyle = '#10b981';\r\n        ctx.beginPath();\r\n        ctx.arc(cx, cy, 10, 0, Math.PI * 2);\r\n        ctx.fill();\r\n        ctx.strokeStyle = '#fff';\r\n        ctx.lineWidth = 2;\r\n        ctx.beginPath();\r\n        ctx.moveTo(cx, cy);\r\n        ctx.lineTo(cx, cy - 22); // Mũi tên tiến\r\n        ctx.stroke();\r\n      } \r\n      else if (currentView === 'slam' && mapData && mapData.data && mapData.data.length > 0) {\r\n        // VẼ BẢN ĐỒ SLAM GRID THỰC TẾ\r\n        const mw = mapData.w;\r\n        const mh = mapData.h;\r\n        const pSize = Math.max(1, Math.min(canvas.width / mw, canvas.height / mh));\r\n        const ox = (canvas.width - mw * pSize) / 2;\r\n        const oy = (canvas.height - mh * pSize) / 2;\r\n\r\n        for (let y = 0; y < mh; y++) {\r\n          for (let x = 0; x < mw; x++) {\r\n            const val = mapData.data[(mh - 1 - y) * mw + x];\r\n            if (val === -1) {\r\n              ctx.fillStyle = '#0b0f19'; // Vùng chưa quét\r\n            } else if (val === 0) {\r\n              ctx.fillStyle = '#1e293b'; // Vùng trống tự do\r\n            } else {\r\n              ctx.fillStyle = '#00f0ff'; // Vật cản / Tường phòng\r\n            }\r\n            ctx.fillRect(ox + x * pSize, oy + y * pSize, pSize, pSize);\r\n          }\r\n        }\r\n      }\r\n\r\n      requestAnimationFrame(render);\r\n    }\r\n\r\n    function updateTrialUI(d) {\n      const c = d.control;\n      if (!c || c.motion_window_s == null) return;\n      isAutoRunning = Boolean(d.auto);\n      document.querySelectorAll('.dpad-btn').forEach(b => { b.disabled = true; });\n      const pidButton = document.querySelector('button[onclick=\"applyPidMini()\"]');\n      if (pidButton) pidButton.disabled = true;\n      const arm = document.getElementById('btnArm');\n      arm.disabled = !c.preflight_ready || c.trial_used || Boolean(c.fault);\n      arm.innerText = c.trial_used ? 'PHIÊN TEST ĐÃ DÙNG' : c.preflight_ready ? 'MỞ PHIÊN TEST 15 GIÂY' : 'ĐANG KIỂM TRA XE';\n      document.getElementById('btnAuto').disabled = !c.armed || Boolean(c.fault);\n      document.getElementById('autoText').innerText = d.auto ? 'DỪNG TEST AUTO' : 'BẬT TEST AUTO 15 GIÂY';\n    }\n\n    // ĐỌC TELEMETRY LIÊN TỤC 10HZ\n    setInterval(() => {\r\n      fetch('/api/telemetry').then(r=>r.json()).then(d=>{\r\n        teleData = d;\n        updateTrialUI(d);\n        document.getElementById('valX').innerText = d.robot.x.toFixed(3);\r\n        document.getElementById('valY').innerText = d.robot.y.toFixed(3);\r\n        document.getElementById('valTh').innerText = (d.robot.th * 180 / Math.PI).toFixed(1) + '°';\r\n        document.getElementById('valLRpm').innerText = Math.abs(d.robot.l_rpm).toFixed(1);\r\n        document.getElementById('valRRpm').innerText = Math.abs(d.robot.r_rpm).toFixed(1);\r\n        document.getElementById('valMinD').innerText = (d.min_m * 100).toFixed(0) + ' cm';\r\n        document.getElementById('distIndicator').innerText = `VẬT CẢN: ${d.min_m.toFixed(2)}m (${d.min_ang}°)`;\r\n\r\n        const badge = document.getElementById('statusBadge');\r\n        if (d.status === 'OBSERVE_ONLY') {\n          badge.className = 'status-badge badge-warn';\n          badge.innerText = 'ĐANG XEM DỮ LIỆU XE — CHƯA BẬT CHẠY' +\n            (d.control && d.control.fault ? ' / ' + d.control.fault : '');\n        } else if (d.map_info && d.map_info.phase && d.auto) {\n          badge.className = 'status-badge badge-warn';\r\n          badge.innerText = 'TỰ HÀNH: ' + d.map_info.phase;\r\n        } else if (d.status === 'DANGER_STOP') {\r\n          badge.className = 'status-badge badge-danger';\r\n          badge.innerText = 'CẢNH BÁO: QUÁ GẦN!';\r\n        } else if (d.status === 'WARNING') {\r\n          badge.className = 'status-badge badge-warn';\r\n          badge.innerText = 'CẢNH BÁO VA CHẠM';\r\n        } else if (d.control && (d.control.fault || d.control.latched)) {\r\n          badge.className = 'status-badge badge-danger';\r\n          badge.innerText = d.control.fault || 'ĐÃ KHÓA — CẦN MỞ PHIÊN RÕ RÀNG';\r\n        } else {\r\n          badge.className = 'status-badge badge-safe';\r\n          badge.innerText = 'TELEMETRY ĐANG CẬP NHẬT';\r\n        }\r\n      }).catch(()=>{\r\n        document.getElementById('statusBadge').innerText = 'MẤT TELEMETRY — CHƯA XÁC NHẬN AN TOÀN';\r\n        ['valLRpm','valRRpm','valX','valY','valTh'].forEach(id => document.getElementById(id).innerText = '--');\r\n        if (driveCmd) stopDrive();\r\n      });\r\n    }, 100);\r\n\r\n    // ĐIỀU KHIỂN BÀN PHÍM WASD\r\n    const SPEED = 110;\r\n    let driveTimer = null;\r\n    let driveCmd = null;\r\n\r\n    function startDrive(c) {\r\n      driveCmd = c;\r\n      sendCmd(c);\r\n      if (driveTimer) clearInterval(driveTimer);\r\n      driveTimer = setInterval(()=>{ if (driveCmd) sendCmd(driveCmd); }, 150);\r\n    }\r\n\r\n    function stopDrive(force = false) {\n      const active = Boolean(sessionTimer || driveCmd || driveTimer);\n      if (sessionTimer) { clearInterval(sessionTimer); sessionTimer = null; }\r\n      driveCmd = null;\r\n      if (driveTimer) { clearInterval(driveTimer); driveTimer = null; }\r\n      if (active || force === true) sendCmd('STOP');\n      document.querySelectorAll('.dpad-btn').forEach(b => b.classList.remove('pressed'));\r\n    }\r\n\r\n    function bind(id, c) {\r\n      const el = document.getElementById(id);\r\n      if (!el) return;\r\n      el.addEventListener('pointerdown', (e)=>{ e.preventDefault(); el.classList.add('pressed'); startDrive(c); });\r\n      const rel = (e)=>{ e.preventDefault(); el.classList.remove('pressed'); stopDrive(); };\r\n      el.addEventListener('pointerup', rel);\r\n      el.addEventListener('pointercancel', rel);\r\n    }\r\n\r\n    bind('btnW', 'M 140 140');\r\n    bind('btnS', 'M -140 -140');\r\n    bind('btnA', 'M -120 120');\r\n    bind('btnD', 'M 120 -120');\r\n    bind('btnQ', 'M -130 130');\r\n    bind('btnE', 'M 130 -130');\r\n\r\n    window.addEventListener('keydown', (e)=>{\r\n      if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;\r\n      if (e.repeat) return;\r\n      if (e.code === 'Space') { e.preventDefault(); emergencyStop(); return; }\r\n      const k = { 'KeyW': 'M 140 140', 'KeyS': 'M -140 -140', 'KeyA': 'M -120 120', 'KeyD': 'M 120 -120', 'KeyQ': 'M -130 130', 'KeyE': 'M 130 -130' };\r\n      if (k[e.code]) { e.preventDefault(); startDrive(k[e.code]); }\r\n    });\r\n\r\n    window.addEventListener('keyup', (e)=>{\r\n      if (driveCmd && (e.code.startsWith('Key') || e.code === 'Space')) { e.preventDefault(); stopDrive(); }\r\n    });\r\n\r\n    window.addEventListener('blur', stopDrive);\r\n    document.addEventListener('visibilitychange', () => { if (document.hidden) stopDrive(); });\r\n    window.addEventListener('pointerup', () => { if (driveCmd) stopDrive(); });\r\n    render();\r\n  </script>\r\n</body>\r\n</html>\r\n"
}
